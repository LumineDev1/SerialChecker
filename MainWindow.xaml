<Window x:Class="SerialChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Serial Checker" Width="1220" Height="860" MinWidth="1000" MinHeight="620"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg.Window}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource Text.Primary}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Sidebar navigation -->
        <Style x:Key="SidebarNav" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="0,0,0,8"/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="10,1"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <Border x:Name="Body" Background="Transparent" CornerRadius="7"/>
                                        <Border x:Name="Rail" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Visibility="Hidden"/>
                                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Bg.SurfaceHover}"/>
                                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Bg.Elevated}"/>
                                            <Setter TargetName="Rail" Property="Visibility" Value="Visible"/>
                                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- "All serials" entry above the category list; looks like a nav item -->
        <Style x:Key="OverviewNav" TargetType="Button">
            <Setter Property="Margin" Value="10,0,10,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Body" Background="Transparent" CornerRadius="7"/>
                            <Border x:Name="Rail" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Visibility="Hidden"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{DynamicResource Bg.SurfaceHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsOverview}" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{DynamicResource Bg.Elevated}"/>
                                <Setter TargetName="Rail" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ════════════════ App shell ════════════════ -->
        <Grid x:Name="Shell">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Sidebar ── -->
            <Border Grid.Column="0" Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,6,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Serial Checker" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource Text.Primary}"/>
                            <TextBlock Text="Hardware ID audit" FontSize="11" Foreground="{StaticResource Text.Tertiary}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Search -->
                    <TextBox x:Name="SearchBox" Grid.Row="1" Margin="14,6,14,12" Style="{StaticResource SearchBox}"
                             Tag="Search all values   Ctrl+F"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- All serials (overview) -->
                    <Button Grid.Row="2" Style="{StaticResource OverviewNav}" Click="OverviewButton_Click" ToolTip="Every value from this scan. Save baseline here saves all tabs.">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8A9;" FontSize="13" HorizontalAlignment="Left">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Foreground" Value="{StaticResource Text.Tertiary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverview}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Accent.Text}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Text="All serials" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Grid.Column="2" Text="{Binding TotalValueCount}" FontSize="11" Foreground="{StaticResource Text.Tertiary}" VerticalAlignment="Center" Margin="8,0,2,0"/>
                        </Grid>
                    </Button>

                    <!-- Categories -->
                    <ListBox x:Name="CategoryList" Grid.Row="3" Style="{StaticResource SidebarNav}"
                             ItemsSource="{Binding CategoriesView}"
                             SelectedItem="{Binding SelectedCategory}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Eyebrow}" Margin="22,12,0,5"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="NavIcon" Text="{Binding Name, Converter={StaticResource CategoryIcon}}" Style="{StaticResource Icon}" FontSize="13" HorizontalAlignment="Left" Foreground="{StaticResource Text.Tertiary}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DisplayItemCount}" FontSize="11" Foreground="{StaticResource Text.Tertiary}" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="NavIcon" Property="Foreground" Value="{DynamicResource Accent.Text}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Status footer -->
                    <Border Grid.Row="4" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="18,12,18,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource Status.Unavailable}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Status.Pass}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding PrivilegeText}" FontSize="11.5" Foreground="{StaticResource Text.Secondary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Made by Lumine" FontSize="11" Foreground="{StaticResource Text.Tertiary}" Margin="15,4,0,0"
                                       ToolTip="{Binding ScanStatusText}" ToolTipService.InitialShowDelay="200"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ── Main column ── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar (inside the draggable caption strip) -->
                <Grid Grid.Row="0" Margin="32,0,150,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center" Margin="0,0,16,0" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding BreadcrumbGroup}" FontSize="12" Foreground="{StaticResource Text.Tertiary}"/>
                        <TextBlock Grid.Column="1" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="8" Foreground="{StaticResource Text.Disabled}" Margin="8,1,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding HeaderTitle}" FontSize="12" Foreground="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                        <Button x:Name="ThemeButton" Style="{StaticResource Btn.Icon}" Width="34" Height="34" Content="&#xE790;" Click="ThemeButton_Click" ToolTip="Colour theme" Margin="0,0,2,0"/>
                        <Popup x:Name="ThemePopup" PlacementTarget="{Binding ElementName=ThemeButton}" Placement="Bottom" HorizontalOffset="-150" VerticalOffset="6"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Bg.Elevated}" BorderBrush="{DynamicResource Border.Strong}" BorderThickness="1" CornerRadius="10" Padding="6" Width="220" Margin="0,0,10,12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.45" Color="Black"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="Colour theme" Style="{StaticResource Eyebrow}" Margin="10,6,0,6"/>
                                    <ItemsControl ItemsSource="{Binding ThemeOptions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource Btn.Ghost}" Height="36" Padding="10,0" HorizontalContentAlignment="Stretch" Click="ThemeOption_Click" Tag="{Binding Key}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Body" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Body" Property="Background" Value="{DynamicResource Bg.SurfaceHover}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Grid Width="186">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Swatch: theme surface ring around its accent -->
                                                        <Border Width="20" Height="20" CornerRadius="10" Background="{Binding SurfaceBrush}" BorderBrush="{StaticResource Text.Disabled}" BorderThickness="1">
                                                            <Ellipse Width="10" Height="10" Fill="{Binding AccentBrush}"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                        <TextBlock Grid.Column="2" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource Accent.Text}"
                                                                   Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Button Style="{StaticResource Btn.Icon}" Width="34" Height="34" Content="&#xE72C;" Click="RefreshButton_Click" ToolTip="{Binding RescanTooltip}" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource Btn}" Click="ExportButton_Click" ToolTip="Save a text report to your Desktop (Ctrl+E)" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEDE1;" Style="{StaticResource Icon}" FontSize="12.5" Margin="0,0,8,0"/>
                                <TextBlock Text="Export"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn}" Click="SaveBaseline_Click" ToolTip="{Binding SaveBaselineTooltip}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="12.5" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding SaveBaselineText}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn.Primary}" Click="CompareButton_Click" ToolTip="Scan again and compare with the saved baseline">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8AB;" Style="{StaticResource Icon}" FontSize="12.5" Margin="0,0,8,0"/>
                                <TextBlock Text="Compare"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Page header -->
                <Grid Grid.Row="1" Margin="32,14,32,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeaderIcon}" Style="{StaticResource Icon}" FontSize="19" Foreground="{DynamicResource Accent.Text}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeaderTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <Grid Margin="0,4,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding HeaderDescription}" FontSize="13" Foreground="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource Chip}" Margin="10,0,0,0">
                                <TextBlock Text="{Binding HeaderCountText}" FontSize="11" Foreground="{StaticResource Text.Secondary}"/>
                            </Border>
                            <!-- Baseline status for what Save baseline would cover -->
                            <Border Grid.Column="2" CornerRadius="6" Padding="7,2" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="{Binding SaveBaselineTooltip}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Bg.Elevated}"/>
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource Text.Tertiary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasScopeBaseline}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Status.Pass.Soft}"/>
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource Status.Pass}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="10" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding BaselineStatusText}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <Button x:Name="GhostCleanupBtn" Grid.Column="2" Style="{StaticResource Btn.Danger}" Click="GhostCleanup_Click" VerticalAlignment="Center"
                            Visibility="{Binding ShowGhostCleanup, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Remove records of USB devices that are no longer connected (asks for administrator approval)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12.5" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding GhostCleanupText}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Rows (flattened + virtualized; each row draws its slice of a card) -->
                <ItemsControl x:Name="RowsList" Grid.Row="2" ItemsSource="{Binding Rows}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              ScrollViewer.CanContentScroll="True"
                              Focusable="False">
                    <ItemsControl.RenderTransform>
                        <TranslateTransform x:Name="RowsTranslate"/>
                    </ItemsControl.RenderTransform>
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer x:Name="RowsScroll" Focusable="False" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter Margin="32,0,22,28"/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- Group header: top of a card -->
                                <Border x:Name="HeaderRow" Visibility="Collapsed" Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1,1,1,0" CornerRadius="10,10,0,0" Padding="16,12,10,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Accent.Text}" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{StaticResource Text.Tertiary}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button x:Name="OpenCategoryBtn" Grid.Column="2" Style="{StaticResource Btn.Ghost}" Height="26" Padding="10,0" FontSize="11.5" Visibility="Collapsed"
                                                Click="OpenCategory_Click" Tag="{Binding CategoryName}" Content="Open category"/>
                                    </Grid>
                                </Border>

                                <!-- Value row -->
                                <Border x:Name="ItemRow" Visibility="Collapsed" Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="{Binding CardBorder}" CornerRadius="{Binding CardCorners}">
                                    <Grid>
                                        <Border x:Name="Divider" Height="1" VerticalAlignment="Top" Background="{DynamicResource Border.Subtle}" Margin="16,0,16,0" Visibility="{Binding ShowDivider, Converter={StaticResource BoolToVisibility}}"/>
                                        <Border x:Name="RowHover" Background="Transparent" CornerRadius="{Binding CardCorners}">
                                            <Grid Margin="16,10,8,10" MinHeight="26">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="230"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding Item.Label, Converter={StaticResource GhostLabel}}" FontSize="12.5" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                                                    <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" Margin="0,5,0,0" Background="{StaticResource Status.Unavailable.Soft}"
                                                            Visibility="{Binding Item.Label, Converter={StaticResource IsGhost}}">
                                                        <TextBlock Text="Disconnected" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Status.Unavailable}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBox Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Item.Value, Mode=OneWay}"
                                                         Foreground="{Binding Item.Value, Converter={StaticResource MutedValueBrush}}"/>
                                                <StackPanel x:Name="RowActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0.35" Margin="8,0,0,0">
                                                    <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" FontSize="12" Content="&#xE8C8;" ToolTip="Copy value" Click="CopyValue_Click" Tag="{Binding Item.Value}"/>
                                                    <Border Width="28" Height="28" Background="Transparent" Cursor="Help" ToolTipService.InitialShowDelay="150">
                                                        <Border.ToolTip>
                                                            <TextBlock Text="{Binding Item.TooltipText}" TextWrapping="Wrap"/>
                                                        </Border.ToolTip>
                                                        <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Empty / placeholder card -->
                                <Border x:Name="EmptyRow" Visibility="Collapsed" Style="{StaticResource Card}" Padding="24,34">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Text.Tertiary}" Margin="0,0,0,12"/>
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{StaticResource Text.Tertiary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Gap between cards -->
                                <Border x:Name="SpacerRow" Visibility="Collapsed" Height="14"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Header">
                                    <Setter TargetName="HeaderRow" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Item">
                                    <Setter TargetName="ItemRow" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Empty">
                                    <Setter TargetName="EmptyRow" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Spacer">
                                    <Setter TargetName="SpacerRow" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowOpenLink}" Value="True">
                                    <Setter TargetName="OpenCategoryBtn" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <Trigger SourceName="RowHover" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowHover" Property="Background" Value="{DynamicResource Bg.SurfaceHover}"/>
                                    <Setter TargetName="RowActions" Property="Opacity" Value="1"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>

        <!-- ════════════════ Loading overlay ════════════════ -->
        <Border x:Name="LoadingScreen" Background="{DynamicResource Bg.Window}" Panel.ZIndex="50">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                <Grid Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,22">
                    <Ellipse Stroke="{DynamicResource Border.Strong}" StrokeThickness="3"/>
                    <Ellipse Stroke="{DynamicResource Accent}" StrokeThickness="3" StrokeDashArray="9 100" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <TextBlock x:Name="LoadingTitle" Text="Scanning this PC" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="LoadingDetail" Text="Reading hardware IDs" FontSize="12.5" Foreground="{StaticResource Text.Tertiary}" HorizontalAlignment="Center" Margin="0,6,0,18"/>
                <Border x:Name="LoadingTrack" Height="3" CornerRadius="1.5" Background="{DynamicResource Border.Subtle}" ClipToBounds="True">
                    <Border x:Name="LoadingBar" Height="3" CornerRadius="1.5" HorizontalAlignment="Left" Width="0" Background="{DynamicResource Accent}"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- ════════════════ Toast ════════════════ -->
        <Border x:Name="ToastCard" Panel.ZIndex="80" Visibility="Collapsed" Opacity="0"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Width="360"
                Background="{DynamicResource Bg.Elevated}" BorderBrush="{DynamicResource Border.Strong}" BorderThickness="1" CornerRadius="10" Padding="14,12,8,12">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTranslate"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.45" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ToastIcon" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="15" VerticalAlignment="Top" Margin="0,2,12,0" Foreground="{StaticResource Status.Pass}"/>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="ToastTitle" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ToastSubtitle" FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    <Button x:Name="ToastActionBtn" Style="{StaticResource Btn}" Height="28" FontSize="12" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed" Click="ToastAction_Click"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Btn.Icon}" Width="26" Height="26" FontSize="10" Content="&#xE8BB;" VerticalAlignment="Top" Click="ToastDismiss_Click" ToolTip="Dismiss"/>
            </Grid>
        </Border>

        <!-- ════════════════ Caption buttons (always on top) ════════════════ -->
        <StackPanel Panel.ZIndex="100" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource Btn.Caption}" Content="&#xE921;" Click="MinimizeButton_Click" ToolTip="Minimize"/>
            <Button x:Name="MaximizeButton" Style="{StaticResource Btn.Caption}" Content="&#xE922;" Click="MaximizeButton_Click" ToolTip="Maximize"/>
            <Button Style="{StaticResource Btn.CaptionClose}" Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="Close"/>
        </StackPanel>
    </Grid>
</Window>
